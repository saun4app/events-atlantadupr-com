{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fixed-partner round-robin configuration",
  "type": "object",
  "required": [
    "version",
    "format",
    "defaults",
    "requirements"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "format": {
      "const": "fixed_partner"
    },
    "defaults": {
      "$ref": "#/$defs/defaults"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    }
  },
  "$defs": {
    "defaults": {
      "type": "object",
      "required": [
        "capacity",
        "rating"
      ],
      "properties": {
        "capacity": {
          "type": "object",
          "required": [
            "minTeams",
            "maxTeams",
            "minParticipants",
            "maxParticipants"
          ],
          "properties": {
            "minTeams": {
              "type": "integer",
              "minimum": 1
            },
            "maxTeams": {
              "type": "integer",
              "minimum": 1
            },
            "minParticipants": {
              "type": "integer",
              "minimum": 2
            },
            "maxParticipants": {
              "type": "integer",
              "minimum": 2
            }
          },
          "additionalProperties": false
        },
        "rating": {
          "type": "object",
          "required": [
            "maxPartnerGap"
          ],
          "properties": {
            "maxPartnerGap": {
              "type": "number",
              "minimum": 0
            },
            "maxPartnerGapInput": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "required": [
        "id",
        "key",
        "condition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}$"
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "object",
          "required": [
            "eventFormat"
          ],
          "properties": {
            "eventFormat": {
              "const": "fixed_partner"
            },
            "operation": {
              "type": "string"
            },
            "operations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "ratingTypes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "ratingType": {
              "type": "string"
            },
            "approvalMode": {
              "type": "string"
            },
            "resolvedPartner": {
              "type": "boolean"
            },
            "bothEffectiveRatings": {
              "type": "boolean"
            },
            "nrAllowed": {
              "type": "boolean"
            },
            "publicRequest": {
              "type": "boolean"
            },
            "adminAdd": {
              "type": "boolean"
            },
            "publicSignup": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "key": {
                "const": "roster_edit_validation"
              }
            }
          },
          "then": {
            "required": [
              "condition",
              "checks",
              "staffBypass"
            ],
            "properties": {
              "condition": {
                "required": [
                  "operation",
                  "ratingTypes",
                  "approvalMode",
                  "resolvedPartner"
                ],
                "properties": {
                  "operation": {
                    "const": "roster_edit"
                  },
                  "ratingTypes": {
                    "contains": {
                      "const": "dupr"
                    },
                    "allOf": [
                      {
                        "contains": {
                          "const": "self_numeric"
                        }
                      }
                    ]
                  },
                  "approvalMode": {
                    "const": "enforce_rating"
                  },
                  "resolvedPartner": {
                    "const": true
                  }
                }
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 3,
                "contains": {
                  "const": "nr"
                },
                "allOf": [
                  {
                    "contains": {
                      "const": "rating_range"
                    }
                  },
                  {
                    "contains": {
                      "const": "partner_rating_gap"
                    }
                  }
                ]
              },
              "staffBypass": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "const": "active_team_membership"
              }
            }
          },
          "then": {
            "required": [
              "condition",
              "scope",
              "membershipRoles",
              "activeStatuses",
              "excludeCurrentRegistrationOnEdit"
            ],
            "properties": {
              "condition": {
                "required": [
                  "operations"
                ],
                "properties": {
                  "operations": {
                    "contains": {
                      "const": "registration"
                    },
                    "allOf": [
                      {
                        "contains": {
                          "const": "roster_edit"
                        }
                      }
                    ]
                  }
                }
              },
              "scope": {
                "const": "event"
              },
              "membershipRoles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 2,
                "contains": {
                  "const": "primary"
                },
                "allOf": [
                  {
                    "contains": {
                      "const": "partner"
                    }
                  }
                ]
              },
              "activeStatuses": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 3,
                "contains": {
                  "const": "confirmed"
                },
                "allOf": [
                  {
                    "contains": {
                      "const": "waitlisted"
                    }
                  },
                  {
                    "contains": {
                      "const": "pending_approval"
                    }
                  }
                ]
              },
              "excludeCurrentRegistrationOnEdit": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "const": "membership_write_serialization"
              }
            }
          },
          "then": {
            "required": [
              "condition",
              "lockStrategy",
              "lockScope",
              "lockNamespace"
            ],
            "properties": {
              "condition": {
                "required": [
                  "operations"
                ],
                "properties": {
                  "operations": {
                    "contains": {
                      "const": "registration_create"
                    },
                    "allOf": [
                      {
                        "contains": {
                          "const": "registration_reactivate"
                        }
                      },
                      {
                        "contains": {
                          "const": "roster_edit"
                        }
                      }
                    ]
                  }
                }
              },
              "lockStrategy": {
                "const": "postgres_advisory_xact"
              },
              "lockScope": {
                "const": "event"
              },
              "lockNamespace": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}