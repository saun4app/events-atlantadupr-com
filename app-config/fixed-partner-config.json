{
  "$schema": "./fixed-partner-config.schema.json",
  "version": 1,
  "format": "fixed_partner",
  "defaults": {
    "capacity": {
      "minTeams": 2,
      "maxTeams": 8,
      "minParticipants": 4,
      "maxParticipants": 12
    },
    "rating": {
      "maxPartnerGap": 0.5,
      "maxPartnerGapInput": 8
    }
  },
  "requirements": [
    {
      "id": "7f3a91c2",
      "key": "partner_registration",
      "condition": {
        "eventFormat": "fixed_partner"
      },
      "required": true,
      "acceptedIdentifiers": [
        "partnerEmail",
        "partnerDuprId"
      ]
    },
    {
      "id": "b82d4e17",
      "key": "team_capacity",
      "condition": {
        "eventFormat": "fixed_partner"
      },
      "playersPerTeam": 2,
      "registrationRepresents": "team"
    },
    {
      "id": "c61a8f03",
      "key": "capacity_defaults",
      "condition": {
        "eventFormat": "fixed_partner"
      },
      "defaultsPath": "defaults.capacity"
    },
    {
      "id": "e94b2a76",
      "key": "partner_rating_gap",
      "condition": {
        "eventFormat": "fixed_partner",
        "ratingType": "dupr",
        "approvalMode": "enforce_rating",
        "resolvedPartner": true,
        "bothEffectiveRatings": true
      },
      "comparison": "less_than_or_equal",
      "fallbackPath": "defaults.rating.maxPartnerGap"
    },
    {
      "id": "4d7c19ab",
      "key": "nr_partner_check",
      "condition": {
        "eventFormat": "fixed_partner",
        "ratingType": "dupr",
        "nrAllowed": false,
        "publicRequest": true
      },
      "check": "primary_and_partner"
    },
    {
      "id": "a53e68d1",
      "key": "partner_rating_range",
      "condition": {
        "eventFormat": "fixed_partner",
        "ratingType": "dupr",
        "approvalMode": "enforce_rating",
        "resolvedPartner": true
      },
      "includePartner": true
    },
    {
      "id": "f28b60e4",
      "key": "admin_add_input",
      "condition": {
        "eventFormat": "fixed_partner",
        "adminAdd": true
      },
      "maxPrimaryEmailsPerSubmission": 1
    },
    {
      "id": "d16e74f9",
      "key": "public_partner_preflight",
      "condition": {
        "eventFormat": "fixed_partner",
        "publicSignup": true
      },
      "requirePartnerBeforeCode": true
    }
  ]
}