{
  "$schema": "./user-roles.schema.json",
  "version": 1,
  "roles": [
    {
      "id": "app_admin",
      "label": "App Admin",
      "badgeTone": "primary"
    },
    {
      "id": "event_organizer",
      "label": "Event Organizer",
      "badgeTone": "blue"
    },
    {
      "id": "club_member",
      "label": "Club Member",
      "badgeTone": "muted"
    },
    {
      "id": "event_captain",
      "label": "Event Captain",
      "badgeTone": "purple"
    },
    {
      "id": "club_director",
      "label": "Club Director",
      "badgeTone": "purple"
    },
    {
      "id": "court_leader",
      "label": "Court Leader",
      "badgeTone": "yellow"
    }
  ],
  "virtualRoles": [
    {
      "id": "site_visitor",
      "label": "Site Visitor",
      "badgeTone": "muted"
    }
  ],
  "defaults": {
    "databaseRole": "club_member",
    "newUserRole": "event_organizer",
    "auditActorRole": "app_admin"
  },
  "groups": {
    "adminOnly": [
      "app_admin"
    ],
    "adminPanel": [
      "app_admin",
      "event_organizer",
      "event_captain",
      "club_director",
      "court_leader"
    ],
    "eventManagers": [
      "app_admin",
      "event_organizer"
    ],
    "eventWriters": [
      "app_admin",
      "event_organizer",
      "event_captain",
      "club_director",
      "court_leader"
    ],
    "assignableStaff": [
      "event_captain",
      "club_director",
      "court_leader"
    ]
  }
}