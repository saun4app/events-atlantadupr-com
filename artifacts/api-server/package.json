{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc --build ../../lib/db ../../lib/api-zod ../../lib/fixed-partner-config ../../lib/rotating-partner-config ../../lib/user-roles-config && tsc -p tsconfig.json --noEmit",
    "test": "export NODE_ENV=test && node --import tsx/esm --test --test-force-exit --test-concurrency=1 \"src/**/*.test.ts\"",
    "test:ci": "export NODE_ENV=test && report_path=\"${API_TEST_REPORT_PATH:-test-results/api-tests.junit.xml}\" && mkdir -p \"$(dirname \"$report_path\")\" && node --import tsx/esm --test --test-force-exit --test-concurrency=1 --test-reporter=junit --test-reporter-destination=\"$report_path\" \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3",
    "@types/bcryptjs": "^3.0.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/fixed-partner-config": "workspace:*",
    "@workspace/rotating-partner-config": "workspace:*",
    "@workspace/user-roles-config": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "qs": "^6.17.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "ajv": "^8.20.0",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
