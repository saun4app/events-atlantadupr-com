{
  "specification": {
    "name": "rotating-partner-event-data-model",
    "version": 1,
    "status": "initial",
    "purpose": "Persistence contract for the rotating-partner event API"
  },
  "module": {
    "id": "rotating-partner-events",
    "boundary": "The module owns these documents and exposes them only through its application services and HTTP API.",
    "futureModuleRule": "Future modules such as fixed-partner events use their own document types and IDs; they do not share domain documents or foreign keys."
  },
  "storage": {
    "format": "json_document",
    "databaseRole": [
      "durability",
      "transactions",
      "document-path-indexes",
      "event-level-locking"
    ],
    "domainColumns": "none",
    "crossModuleReferences": "stable_id_only",
    "relationalForeignKeys": false,
    "newOptionalFieldPolicy": "Add the field to the document schema version and validator. Do not add a relational column or require a per-field database migration.",
    "documentEvolution": {
      "versionField": "schemaVersion",
      "readerCompatibility": "Readers accept the current version and older versions with version-aware defaults.",
      "writerBehavior": "Writers emit the current version.",
      "upgradeBehavior": "Use an explicit, idempotent document upgrade when a field cannot be handled by a default.",
      "unknownFields": "Preserve unknown fields when safe; reject unknown fields that would change a security, identity, lifecycle, or capacity decision."
    }
  },
  "documentEnvelope": {
    "requiredFields": [
      "documentId",
      "documentType",
      "schemaVersion",
      "module",
      "createdAt",
      "updatedAt",
      "data"
    ],
    "fields": {
      "documentId": {
        "type": "string",
        "format": "opaque-id",
        "description": "Stable identifier generated by the API server."
      },
      "documentType": {
        "type": "string",
        "enum": [
          "rotating_event",
          "rotating_registration",
          "participant_profile",
          "rotating_event_defaults",
          "event_assignment",
          "email_verification",
          "audit_record"
        ]
      },
      "schemaVersion": {
        "type": "integer",
        "minimum": 1
      },
      "module": {
        "type": "string",
        "const": "rotating-partner-events"
      },
      "createdAt": {
        "type": "string",
        "format": "date-time",
        "wireFormat": "RFC3339 UTC"
      },
      "updatedAt": {
        "type": "string",
        "format": "date-time",
        "wireFormat": "RFC3339 UTC"
      },
      "data": {
        "type": "object",
        "description": "Document-type-specific JSON payload."
      }
    }
  },
  "commonConventions": {
    "timestamps": "RFC3339 UTC strings on the API and in JSON documents.",
    "nullable": "Use null when a known field is intentionally empty; omit only optional fields introduced by a later document version.",
    "references": "Store stable IDs such as eventId, registrationId, participantId, and userId. References are resolved by the module service and are not database foreign keys.",
    "money": "Non-negative decimal number represented in cents or a documented fixed-precision decimal; the API must choose one representation and use it consistently.",
    "email": "Normalize for lookup and verification, but retain the snapshot value required for historical display.",
    "statusChanges": "Write lifecycle metadata and an audit record in the same transaction as the status change.",
    "optimisticConcurrency": "Mutation requests may include an expectedUpdatedAt or documentVersion; stale writes fail with a conflict instead of overwriting newer data."
  },
  "documents": [
    {
      "documentType": "rotating_event",
      "collection": "rotating_partner_events",
      "identity": {
        "primaryId": "eventId",
        "references": "Registrations, assignments, and audit records reference eventId."
      },
      "fields": [
        { "path": "eventId", "type": "string", "required": true, "format": "opaque-id" },
        { "path": "seriesId", "type": "string", "required": false, "nullable": true },
        { "path": "name", "type": "string", "required": true, "minLength": 1 },
        { "path": "description", "type": "string", "required": false, "nullable": true },
        { "path": "eventDescription", "type": "string", "required": false, "nullable": true },
        { "path": "startDatetime", "type": "string", "required": true, "format": "date-time" },
        { "path": "endDatetime", "type": "string", "required": true, "format": "date-time" },
        { "path": "timeZone", "type": "string", "required": true, "description": "IANA timezone used to interpret event-local input." },
        { "path": "locationName", "type": "string", "required": true },
        { "path": "locationAddress", "type": "string", "required": false, "default": "" },
        { "path": "ratingTypeRequired", "type": "string", "required": true, "enum": ["none", "dupr", "self_numeric", "self_skill"] },
        { "path": "ratingConfig", "type": "object", "required": false, "nullable": true, "description": "Type-specific event rating bounds." },
        { "path": "minParticipants", "type": "integer", "required": true, "minimum": 1 },
        { "path": "maxParticipants", "type": "integer", "required": true, "minimum": 1 },
        { "path": "waitlistEnabled", "type": "boolean", "required": true },
        { "path": "requireApproval", "type": "string", "required": true, "enum": ["none", "all", "nr_only", "enforce_rating"] },
        { "path": "signupStartDatetime", "type": "string", "required": true, "format": "date-time" },
        { "path": "signupEndDatetime", "type": "string", "required": true, "format": "date-time" },
        { "path": "showSignupEnd", "type": "boolean", "required": true },
        { "path": "status", "type": "string", "required": true, "enum": ["upcoming", "closed", "ended", "cancelled"] },
        { "path": "courtFeeEnabled", "type": "boolean", "required": true },
        { "path": "memberFee", "type": "number", "required": true, "minimum": 0 },
        { "path": "nonMemberFee", "type": "number", "required": true, "minimum": 0 },
        { "path": "contactEmail", "type": "string", "required": false, "nullable": true, "format": "email" }
      ],
      "integrity": [
        "endDatetime is after startDatetime.",
        "signupStartDatetime is not after signupEndDatetime.",
        "minParticipants is not greater than maxParticipants.",
        "The event status and ratingConfig are validated by rotating-partner-event-config.json.",
        "A rotating event cannot reference a fixed-partner document."
      ],
      "indexes": [
        { "paths": ["status", "startDatetime"], "purpose": "Upcoming event listing." },
        { "paths": ["signupStartDatetime", "signupEndDatetime"], "purpose": "Signup-window filtering." },
        { "paths": ["seriesId"], "purpose": "Series grouping when present." }
      ]
    },
    {
      "documentType": "rotating_registration",
      "collection": "rotating_partner_registrations",
      "identity": {
        "primaryId": "registrationId",
        "references": "The registration references eventId and participantId by stable ID."
      },
      "fields": [
        { "path": "registrationId", "type": "string", "required": true, "format": "opaque-id" },
        { "path": "eventId", "type": "string", "required": true, "format": "opaque-id" },
        { "path": "participantId", "type": "string", "required": true, "format": "opaque-id" },
        { "path": "partnerId", "type": "string", "required": false, "nullable": true, "format": "opaque-id" },
        { "path": "status", "type": "string", "required": true, "enum": ["confirmed", "waitlisted", "pending_approval", "rejected", "cancelled", "no_show"] },
        { "path": "eventRole", "type": "string", "required": false, "nullable": true },
        { "path": "isNew", "type": "boolean", "required": false, "default": false },
        { "path": "assignedRating", "type": "number", "required": false, "nullable": true },
        { "path": "playerSnapshot", "type": "object", "required": true, "description": "Participant values captured at write time." },
        { "path": "partnerSnapshot", "type": "object", "required": false, "nullable": true, "description": "Partner values captured at write time when applicable." },
        { "path": "registeredAt", "type": "string", "required": true, "format": "date-time" },
        { "path": "approvedAt", "type": "string", "required": false, "nullable": true, "format": "date-time" },
        { "path": "approvedBy", "type": "string", "required": false, "nullable": true, "format": "opaque-id" },
        { "path": "cancelledAt", "type": "string", "required": false, "nullable": true, "format": "date-time" },
        { "path": "cancelledBy", "type": "string", "required": false, "nullable": true }
      ],
      "snapshot": {
        "playerFields": ["name", "doubles", "singles", "selfRating", "email", "phone"],
        "partnerFields": ["partnerName", "partnerDoubles", "partnerSelfRating"],
        "source": "participant_profile_at_write",
        "sourceOfTruth": "registration_document",
        "assignedRating": "numeric_member_doubles_or_null"
      },
      "integrity": [
        "eventId identifies a rotating_event within the rotating module.",
        "participantId identifies the participant used for duplicate-active-registration checks.",
        "At most one active registration exists for a participant in an event.",
        "A cancelled registration may be reactivated in place only when the configured policy permits it.",
        "Status metadata is consistent with the status transition that produced it."
      ],
      "indexes": [
        { "paths": ["eventId", "status"], "purpose": "Roster and capacity calculations." },
        { "paths": ["eventId", "participantId", "status"], "purpose": "Duplicate active-registration checks." },
        { "paths": ["playerSnapshot.email"], "purpose": "Public cancellation lookup." },
        { "paths": ["registeredAt"], "purpose": "Historical ordering." }
      ]
    },
    {
      "documentType": "participant_profile",
      "collection": "rotating_partner_participants",
      "identity": {
        "primaryId": "participantId",
        "externalIdentifiers": ["memberDuprId", "normalizedEmail"]
      },
      "fields": [
        { "path": "participantId", "type": "string", "required": true, "format": "opaque-id" },
        { "path": "memberDuprId", "type": "string", "required": false, "nullable": true },
        { "path": "name", "type": "string", "required": true },
        { "path": "doubles", "type": "string", "required": false, "nullable": true },
        { "path": "doublesReliability", "type": "integer", "required": false, "nullable": true },
        { "path": "singles", "type": "string", "required": false, "nullable": true },
        { "path": "singlesReliability", "type": "integer", "required": false, "nullable": true },
        { "path": "selfRating", "type": "string", "required": false, "nullable": true },
        { "path": "email", "type": "string", "required": false, "nullable": true, "format": "email" },
        { "path": "phone", "type": "string", "required": false, "nullable": true }
      ],
      "indexes": [
        { "paths": ["memberDuprId"], "purpose": "Accepted participant lookup." },
        { "paths": ["normalizedEmail"], "purpose": "Email lookup without exposing raw email in an index." }
      ],
      "privacy": "Access is role-limited; registration snapshots are not rewritten when this document changes."
    },
    {
      "documentType": "rotating_event_defaults",
      "collection": "rotating_partner_event_defaults",
      "identity": { "primaryId": "defaultsId" },
      "fields": [
        { "path": "defaultsId", "type": "string", "required": true, "format": "opaque-id" },
        { "path": "minParticipants", "type": "integer", "required": true, "minimum": 1 },
        { "path": "maxParticipants", "type": "integer", "required": true, "minimum": 1 },
        { "path": "source", "type": "string", "required": true, "enum": ["database_event_defaults", "json_initial_fallback"] }
      ],
      "integrity": ["minParticipants is not greater than maxParticipants."],
      "precedence": "An event-specific value wins over these defaults; these defaults win over the JSON initial fallback."
    },
    {
      "documentType": "event_assignment",
      "collection": "rotating_partner_event_assignments",
      "identity": { "primaryId": "assignmentId" },
      "fields": [
        { "path": "assignmentId", "type": "string", "required": true, "format": "opaque-id" },
        { "path": "eventId", "type": "string", "required": true, "format": "opaque-id" },
        { "path": "userId", "type": "string", "required": true, "format": "opaque-id" },
        { "path": "role", "type": "string", "required": true, "enum": ["event_captain", "court_leader"] },
        { "path": "assignedAt", "type": "string", "required": true, "format": "date-time" }
      ],
      "integrity": ["The pair eventId/userId is unique within the rotating module."]
    },
    {
      "documentType": "email_verification",
      "collection": "rotating_partner_email_verifications",
      "identity": { "primaryId": "verificationId" },
      "fields": [
        { "path": "verificationId", "type": "string", "required": true, "format": "opaque-id" },
        { "path": "normalizedEmail", "type": "string", "required": true },
        { "path": "codeHash", "type": "string", "required": true, "description": "Never store the clear-text code." },
        { "path": "attempts", "type": "integer", "required": true, "minimum": 0 },
        { "path": "lastSentAt", "type": "string", "required": true, "format": "date-time" },
        { "path": "expiresAt", "type": "string", "required": true, "format": "date-time" },
        { "path": "consumedAt", "type": "string", "required": false, "nullable": true, "format": "date-time" }
      ],
      "integrity": [
        "Clear-text verification codes are never persisted or logged.",
        "Expired and consumed records are not accepted for verification.",
        "TTL, cooldown, attempt limits, and code format come from rotating-partner-event-config.json."
      ],
      "indexes": [
        { "paths": ["normalizedEmail"], "purpose": "Current-code lookup." },
        { "paths": ["expiresAt"], "purpose": "Cleanup." }
      ],
      "retention": "Delete or anonymize expired and consumed records according to the deployment retention policy."
    },
    {
      "documentType": "audit_record",
      "collection": "rotating_partner_audit_records",
      "identity": { "primaryId": "auditId" },
      "fields": [
        { "path": "auditId", "type": "string", "required": true, "format": "opaque-id" },
        { "path": "actorId", "type": "string", "required": false, "nullable": true, "format": "opaque-id" },
        { "path": "action", "type": "string", "required": true },
        { "path": "resourceType", "type": "string", "required": true },
        { "path": "resourceId", "type": "string", "required": true, "format": "opaque-id" },
        { "path": "occurredAt", "type": "string", "required": true, "format": "date-time" },
        { "path": "requestId", "type": "string", "required": false, "nullable": true },
        { "path": "details", "type": "object", "required": false, "description": "Redacted, non-secret change metadata." }
      ],
      "privacy": "Do not store verification codes, credentials, full payment data, or unnecessary participant PII."
    }
  ],
  "transactionRules": {
    "capacityMutations": [
      "registration_create",
      "registration_reactivate",
      "approval",
      "waitlist_promotion",
      "roster_edit",
      "event_limit_update"
    ],
    "lockScope": "eventId",
    "requiredBehavior": "Read current event and registration documents after acquiring the event lock, calculate capacity from configured statuses, then commit the document mutation and audit record atomically.",
    "conflictBehavior": "Return a typed conflict or configured waitlist result; never silently overwrite a concurrent capacity decision."
  }
}